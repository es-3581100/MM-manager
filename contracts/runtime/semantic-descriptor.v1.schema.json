{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mm-manager.local/contracts/semantic-descriptor.v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "object_id",
    "kind",
    "dependencies",
    "mutability",
    "recomputability",
    "confidence",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "memory-matrix.semantic-descriptor/v1"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mutability": {
      "enum": [
        "UNKNOWN",
        "MUTABLE",
        "READ_MOSTLY",
        "IMMUTABLE"
      ]
    },
    "recomputability": {
      "enum": [
        "UNKNOWN",
        "YES",
        "NO"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}

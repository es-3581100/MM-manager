{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mm-manager.local/contracts/semantic-descriptor-set.v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "source_project_schema",
    "source_project_id",
    "adapter",
    "inference_boundary",
    "descriptors"
  ],
  "properties": {
    "schema_version": {
      "const": "memory-matrix.semantic-descriptor-set/v1"
    },
    "source_project_schema": {
      "const": "app-dir-matrix.project/v1"
    },
    "source_project_id": {
      "type": "string"
    },
    "adapter": {
      "const": "mm-manager.project-to-semantic/v1"
    },
    "inference_boundary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "descriptors": {
      "type": "array"
    }
  },
  "additionalProperties": false
}

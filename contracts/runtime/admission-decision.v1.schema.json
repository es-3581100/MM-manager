{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mm-manager.local/contracts/admission-decision.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "prediction_id", "object_id", "evaluated_at_nanos", "admitted", "reason", "expected_benefit_nanos", "expected_cost_nanos", "outstanding_prefetch_bytes", "queue_depth"],
  "properties": {
    "schema_version": {"const": "memory-matrix.admission-decision/v1"},
    "prediction_id": {"type": ["string", "null"]},
    "object_id": {"type": ["string", "null"]},
    "evaluated_at_nanos": {"type": "integer", "minimum": 0},
    "admitted": {"type": "boolean"},
    "reason": {"type": "string"},
    "expected_benefit_nanos": {"type": ["integer", "null"], "minimum": 0},
    "expected_cost_nanos": {"type": ["integer", "null"], "minimum": 0},
    "outstanding_prefetch_bytes": {"type": "integer", "minimum": 0},
    "queue_depth": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
